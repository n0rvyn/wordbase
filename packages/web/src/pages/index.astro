---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBody from '../components/page-bodies/HomeBody.astro';
import { loadHomeData } from '../lib/home';

import { getSiteIdentity } from '../lib/api';
import { resolveSiteCopy } from '../lib/site-copy';
const copy = resolveSiteCopy((await getSiteIdentity()).copy);

const data = await loadHomeData('zh');
---

<BaseLayout title={copy.shareTitleZh} titleEn={copy.shareTitleEn} description={copy.shareDescriptionZh} hasEnTwin>
  <HomeBody locale="zh" {...data} />
</BaseLayout>
