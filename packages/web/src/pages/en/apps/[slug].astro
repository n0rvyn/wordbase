---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppDetailBody from '../../../components/page-bodies/AppDetailBody.astro';
import { getApps, stripMarkdown, type App } from '../../../lib/api';
import { localizeApp } from '../../../lib/localize';
import { buildSoftwareApplicationLd, buildBreadcrumbLd } from '../../../lib/jsonld.js';

export async function getStaticPaths() {
  const { data: apps } = await getApps({ status: 'published', limit: 10000 });
  // Localize ONCE for the whole set, not per page: the "more apps" strip needs
  // every other app localized too, and doing it inside the map would issue
  // N×(N-1) rendition requests to render the same N apps.
  const localized = await Promise.all(apps.map((a: App) => localizeApp(a, 'en')));
  return localized.map((app: App) => ({
    params: { slug: app.slug },
    props: {
      app,
      moreApps: localized.filter((a: App) => a.slug !== app.slug),
    },
  }));
}

// Already localized in getStaticPaths: tagline + features from the translation
// cache, name/description/price/whatsNew from the English storefront's own
// listing (meta.i18n.en, written by app_sync).
const { app: localized, moreApps } = Astro.props as { app: App; moreApps: App[] };

const metaDescription =
  localized.tagline ||
  (localized.description ? stripMarkdown(localized.description, 155) : '') ||
  localized.subtitle ||
  undefined;

const origin = Astro.site!.href.replace(/\/$/, '');
const jsonLd = [
  buildSoftwareApplicationLd(localized, origin),
  buildBreadcrumbLd([
    { name: 'Apps', url: `${origin}/en/apps` },
    { name: localized.name, url: `${origin}/en/apps/${localized.slug}` },
  ]),
];
---

<BaseLayout title={localized.name} description={metaDescription} ogImage={`/og/en/apps/${localized.slug}.png`} jsonLd={jsonLd} locale="en">
  <AppDetailBody locale="en" app={localized} moreApps={moreApps} />
</BaseLayout>
