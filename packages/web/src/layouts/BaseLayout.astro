---
import '../styles/tokens.css';
import '../styles/public.css';
import '../styles/design-study.css';
import { buildWebSiteLd, buildOrganizationLd } from '../lib/jsonld.js';
import { getSiteIdentity } from '../lib/api';
import { hreflangAlternates, stripEn, publicPathname } from '../lib/locale';
import T from '../components/T.astro';
import { socialImage, socialDescription, SITE_SOCIAL_ALT, SOCIAL_SITE_NAME, pageTitle } from '../lib/social-preview';
import { resolveSiteCopy } from '../lib/site-copy';
import PublicSearch from '../components/PublicSearch.astro';

interface Props {
  title: string;
  /** English title for client-side <title> swap when language is en.
   *  Static <title> still renders Chinese (crawler/no-JS default);
   *  the bundled script overwrites document.title at runtime. Leave
   *  undefined for API-derived titles (posts, apps, podcast, tag/category
   *  detail pages) where the title IS the content and stays Chinese. */
  titleEn?: string;
  description?: string;
  /** Explicit empty social copy is allowed without clearing the SEO description. */
  shareDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  article?: { publishedTime?: number; modifiedTime?: number; author?: string; section?: string; tags?: string[] };
  jsonLd?: object[];
  // Extra <link rel="alternate"> feeds beyond the site blog feed (e.g. the
  // podcast page injects its show feed, whose slug only the page knows).
  feeds?: { title: string; href: string }[];
  /** Active page locale. Default 'zh' (zero-regression for existing zh +
   *  admin pages). When 'en', the layout emits `<html lang="en" data-lang="en">`
   *  so chrome is English at first paint. */
  locale?: 'zh' | 'en';
  /** True when this zh page has a /en/ twin (posts/[slug], [slug], apps/[slug],
   *  index, about, 404, writing/index, categories/*, tags/*, page/[page]).
   *  Adds the hreflang set pointing to the en twin, so the zh page also
   *  declares its alternates. Bidirectional hreflang is required by Google. */
  hasEnTwin?: boolean;
  /** Emit <meta name="robots" content="noindex, follow"> for thin/utility
   *  pages that shouldn't be indexed (e.g. /search). Links are still followed. */
  noindex?: boolean;
}

const { title, titleEn, description: descriptionProp, shareDescription: shareDescriptionProp, ogImage, ogImageAlt, ogType = 'website', article, jsonLd = [], feeds = [], locale = 'zh', hasEnTwin = false, noindex = false } = Astro.props;
const id = await getSiteIdentity();
const copy = resolveSiteCopy(id.copy);
// X/Twitter handle for card attribution.
const TWITTER_HANDLE = '@NorvynZhang';
// Fallback to the site's real description (settings-driven) when a page passes
// none — never a generic placeholder. Page-specific descriptions still win.
const description = socialDescription(descriptionProp, title, id.name, id.description);
const previewDescription = shareDescriptionProp ?? description;
const siteTitle = id.name;
const isHome = ['/', '/en'].includes(publicPathname(Astro.url.pathname));
const fullTitle = isHome ? title : pageTitle(title, siteTitle);
const fullTitleEn = titleEn ? (isHome ? titleEn : pageTitle(titleEn, siteTitle)) : '';
const apiUrl = (import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4100').replace(/\/$/, '');
const currentPath = publicPathname(Astro.url.pathname);
const social = socialImage(ogImage, Astro.site!);
const ogImageUrl = social.url;
const imageAlt = ogImageAlt || (ogImage ? fullTitle : SITE_SOCIAL_ALT);
const canonicalUrl = new URL(currentPath, Astro.site).href;
const ldOrigin = Astro.site!.href.replace(/\/$/, '');
const isoMeta = (ts: number | undefined) => (ts ? new Date(ts * 1000).toISOString() : undefined);

// navItems + footer items — locale-aware. En pages prefix /en on every
// internal link except /podcast (no en twin). isActive strips the /en
// prefix before comparing so the same nav item is active on /posts/foo
// AND /en/posts/foo.
const en = locale === 'en';
const path = stripEn(currentPath);
const space = path === '/' ? 'home' : path.startsWith('/apps') ? 'apps' : path.startsWith('/podcast') ? 'podcast' : path.startsWith('/writing') || path.startsWith('/posts') || path.startsWith('/categories') || path.startsWith('/tags') || path.startsWith('/archives') || path.startsWith('/page/') ? 'writing' : 'page';
const navItems = [
  { href: en ? '/en' : '/', zh: '首页', en: 'Home', isActive: space === 'home' },
  { href: en ? '/en/writing' : '/writing', zh: '博客', en: 'Writing', isActive: space === 'writing' },
  { href: '/podcast', zh: '播客', en: 'Podcast', isActive: space === 'podcast' },
  { href: en ? '/en/apps' : '/apps', zh: '应用', en: 'Apps', isActive: space === 'apps' },
];
const footerLinks = {
  apps:       en ? '/en/apps'       : '/apps',
  writing:    en ? '/en/writing'    : '/writing',
  // podcast has no en twin — both locales link to /podcast
  podcast:    '/podcast',
  about:      en ? '/en/about'      : '/about',
  categories: en ? '/en/categories' : '/categories',
  tags:       en ? '/en/tags'       : '/tags',
  archives:   en ? '/en/archives'   : '/archives',
};

// hreflang set: only emit when this page declares itself as part of the
// bilingual subtree. en pages always declare; zh pages only when hasEnTwin.
const emitHreflang = en || hasEnTwin;
const hreflangs = emitHreflang ? hreflangAlternates(currentPath, Astro.site) : [];
// og:locale (+ alternate when the page has a twin in the other language).
const ogLocale = en ? 'en_US' : 'zh_CN';
const ogLocaleAlt = en ? 'zh_CN' : 'en_US';
---

<html prefix="og: https://ogp.me/ns#" data-public="true" lang={en ? 'en' : 'zh-CN'} data-theme="light" data-lang={en ? 'en' : undefined} data-has-en-twin={(hasEnTwin && !en) ? 'true' : undefined} data-title-en={fullTitleEn || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} — 文章`} href="/rss.xml" />
    {feeds.map((f) => (
      <link rel="alternate" type="application/rss+xml" title={f.title} href={f.href} />
    ))}
    {hreflangs.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SOCIAL_SITE_NAME} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    {previewDescription && <meta property="og:description" content={previewDescription} />}
    <meta property="og:image" content={ogImageUrl} />
    {ogImageUrl.startsWith('https:') && <meta property="og:image:secure_url" content={ogImageUrl} />}
    {social.type && <meta property="og:image:type" content={social.type} />}
    {social.width && <meta property="og:image:width" content={String(social.width)} />}
    {social.height && <meta property="og:image:height" content={String(social.height)} />}
    <meta property="og:image:alt" content={imageAlt} />
    {social.square && <>
      <meta property="og:image" content={social.square} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="600" />
      <meta property="og:image:height" content="600" />
      <meta property="og:image:alt" content={SITE_SOCIAL_ALT} />
    </>}
    <link rel="image_src" href={social.square || ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    {emitHreflang && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
    {ogType === 'article' && article && (
      <>
        {isoMeta(article.publishedTime) && <meta property="article:published_time" content={isoMeta(article.publishedTime)} />}
        {isoMeta(article.modifiedTime) && <meta property="article:modified_time" content={isoMeta(article.modifiedTime)} />}
        {article.author && <meta property="article:author" content={article.author} />}
        {article.section && <meta property="article:section" content={article.section} />}
        {article.tags?.map((t) => (
          <meta property="article:tag" content={t} />
        ))}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={TWITTER_HANDLE} />
    <meta name="twitter:creator" content={TWITTER_HANDLE} />
    <meta name="twitter:title" content={fullTitle} />
    {previewDescription && <meta name="twitter:description" content={previewDescription} />}
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {[buildWebSiteLd(ldOrigin, { ...id, name: SOCIAL_SITE_NAME }), buildOrganizationLd(ldOrigin, id), ...jsonLd].map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj).replaceAll('<', String.fromCharCode(92)+'u003c')} />
    ))}
    <title>{fullTitle}</title>
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Noto+Sans+SC:wght@300;400;500;700;900&display=swap" rel="stylesheet" />
    <!-- FOUC-prevention bootstrap: read localStorage['norvyn-v2'] before paint.
         is:inline + in <head> => runs synchronously before <body> paints (no FOUC).
         Cannot import src/lib/theme.ts here; this hand-mirrors readPrefs +
         resolveTheme/resolveAccent. Keep in sync with that module.
         Also resolves the active UI language — mirrors lib/i18n.ts detectLang()
         three-level guard exactly: stored 'zh'/'en' wins, else falsy
         navigator.language → 'zh' default BEFORE the startsWith('zh') check,
         else prefix test. -->
    <script is:inline>
      (function() {
        var LS = 'norvyn-v2';
        var DEFAULT_THEME = 'system';
        var DEFAULT_ACCENT = '#ff5b2d';
        // Phase 4: /en/ pages force lang='en' at first paint even if a
        // returning visitor has lang='zh' in localStorage. Without this,
        // the inline script would revert chrome to Chinese on /en/* and
        // the chrome would flicker. The catch branch mirrors the same rule
        // for the (rare) case where localStorage parsing throws.
        var path = location.pathname === '/index.html' ? '/' : (location.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/');
        var onEn = path === '/en' || path.indexOf('/en/') === 0;
        try {
          var stored = JSON.parse(localStorage.getItem(LS) || '{}');
          if (!stored || typeof stored !== 'object' || Array.isArray(stored)) stored = {};
          var preference = stored.theme === 'dark' || stored.theme === 'light' ? stored.theme : DEFAULT_THEME;
          var theme = preference === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : preference;
          var accent = stored.accent || (theme === 'dark' ? '#ff916d' : DEFAULT_ACCENT);
          var lang = (stored.lang === 'zh' || stored.lang === 'en') ? stored.lang : (!navigator.language ? 'zh' : (navigator.language.toLowerCase().indexOf('zh') === 0 ? 'zh' : 'en'));
          if (onEn) lang = 'en';
          // Phase 5: en visitor (non-zh UA, no saved language pref) landing on a
          // zh bilingual URL gets redirected once to its /en twin, before paint.
          // Guards: only on pages that HAVE an en twin (data-has-en-twin, set on
          // zh bilingual pages only); skip if a language was ever chosen (stored.lang);
          // skip /en pages (no twin attr there). No loop: /en pages lack the attr.
          var hasEnTwin = document.documentElement.getAttribute('data-has-en-twin') === 'true';
          if (hasEnTwin && !onEn && !(stored && stored.lang) && navigator.language && navigator.language.toLowerCase().indexOf('zh') !== 0) {
            location.replace('/en' + (path === '/' ? '' : path));
            return;
          }
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.style.setProperty('--accent', accent);
          document.documentElement.setAttribute('data-lang', lang);
          document.documentElement.setAttribute('lang', lang === 'en' ? 'en' : 'zh-CN');
        } catch(e) {
          document.documentElement.setAttribute('data-theme', matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          var fallbackLang = onEn ? 'en' : 'zh';
          document.documentElement.setAttribute('data-lang', fallbackLang);
          document.documentElement.setAttribute('lang', fallbackLang === 'en' ? 'en' : 'zh-CN');
        }
      })();
    </script>
  </head>
  <body data-api-url={apiUrl} data-space={space}>
    <a class="skip-link" href="#main"><T zh="跳到内容" en="Skip to content" /></a>
    <nav class="nav" id="nav">
      <div class="wrap nav-in">
        <a class="brand cafe-wordmark" href={en ? '/en' : '/'} aria-label={en ? 'Julian.Cafe — Home' : 'Julian.Cafe — 首页'}>
          <span aria-hidden="true"><span>Julian</span><span class="cafe-period">.</span><span class="cafe-stamp">Cafe</span></span>
        </a>
        <div class="nav-links" id="navLinks">
          {navItems.map(item => (
            <a href={item.href} class:list={[{ active: item.isActive }]} aria-current={item.isActive ? 'page' : undefined}><T zh={item.zh} en={item.en} /></a>
          ))}
          <a class="nav-search-mobile" href={en ? '/en/search' : '/search'}><T zh="搜索" en="Search" /></a>
        </div>
        <div class="nav-r">
            <a class="icon-btn" id="searchLink" href={en ? '/en/search' : '/search'} aria-label={en ? 'Search' : '搜索'}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg><span class="search-label"><T zh="搜索" en="Search" /></span><kbd aria-hidden="true">/</kbd>
            </a>
          <label class="theme-control icon-btn">
            <span class="sr-only"><T zh="外观" en="Appearance" /></span>
            <select id="themeSelect" aria-label={en ? 'Appearance' : '外观'}>
              <option value="system">{en ? 'System' : '跟随系统'}</option>
              <option value="light">{en ? 'Light' : '浅色'}</option>
              <option value="dark">{en ? 'Dark' : '深色'}</option>
            </select>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"/></svg>
          </label>
          <button class="icon-btn lang-btn" id="langBtn" data-i18n-aria="common.langToggle" aria-label="切换语言">
            <span class="lang-zh">中</span><span class="lang-en">EN</span>
          </button>
          <button class="icon-btn nav-burger" id="navBurger" aria-expanded="false" aria-controls="navLinks" data-i18n-aria="common.menu" aria-label="菜单">
            <svg class="burger-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            <svg class="burger-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
      </div>
    </nav>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <PublicSearch />

    <footer class="study-footer">
      <div class="wrap study-footer-inner">
        <div class="study-footer-identity">
          <a class="brand" href={en ? '/en' : '/'}><span>{siteTitle}</span><span class="footer-dot" aria-hidden="true">·</span></a>
          <p><span class="i18n"><span data-l="zh">{copy.footerZh}</span><span data-l="en">{copy.footerEn}</span></span></p>
        </div>
        <div class="study-footer-directory">
        <nav class="study-footer-group" aria-label={en ? 'Explore' : '浏览'}>
          <h2><T zh="浏览" en="Explore" /></h2>
          <a href={footerLinks.writing}><T zh="博客" en="Writing" /></a>
          <a href={footerLinks.apps}><T zh="应用" en="Apps" /></a>
          <a href={footerLinks.podcast}><T zh="播客" en="Podcast" /></a>
        </nav>
        <nav class="study-footer-group" aria-label={en ? 'Writing index' : '文章索引'}>
          <h2><T zh="文章索引" en="Writing index" /></h2>
          <a href={footerLinks.categories}><T k="foot.linkCategories" /></a>
          <a href={footerLinks.tags}><T k="foot.linkTags" /></a>
          <a href={footerLinks.archives}><T k="foot.linkArchives" /></a>
        </nav>
        <nav class="study-footer-group" aria-label={en ? 'Connect' : '联系'}>
          <h2><T zh="联系" en="Connect" /></h2>
          <a href={footerLinks.about}><T zh="关于" en="About" /> ↗</a>
          <a href={`mailto:${id.email}`}><T zh="联系" en="Contact" /> ↗</a>
          <a href={id.github}>GitHub ↗</a>
        </nav>
        <nav class="study-footer-group" aria-label={en ? 'Resources' : '资源'}>
          <h2><T zh="资源" en="Resources" /></h2>
          <a href="/rss.xml"><T zh="订阅 RSS" en="RSS feed" /></a>
          <a href="/sitemap.xml"><T zh="站点地图" en="Sitemap" /></a>
        </nav>
        </div>
        <div class="study-footer-bottom"><small class="study-copyright">© {new Date().getFullYear()} {siteTitle}</small><small>{copy.footerNote}</small></div>
      </div>
    </footer>

    <!-- Theme + language toggle + nav scroll border. Bundled module so it can
         reuse the tested persistence helpers in src/lib/theme.ts and the
         i18n helpers in src/lib/i18n.ts (single source of truth). -->
    <script>
      import {
        THEME_LS_KEY,
        readPrefs,
        mergePrefs,
        themePreference,
        resolveTheme,
        type ThemePreference,
        resolveAccent,
      } from '../lib/theme';
      import {
        applyAttrI18n,
        nextLang,
        type Lang,
      } from '../lib/i18n';
      import { enHref, stripEn, isEnPath, publicPathname } from '../lib/locale';

      function applyToDom(theme: string, accent: string) {
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.setProperty('--accent', accent);
      }

      // Capture the server-rendered <title> once (the Chinese original) before
      // any swap, so toggling back to ZH can restore it.
      const ssrTitle = document.title;

      function applyLangToDom(lang: Lang) {
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.setAttribute('lang', lang === 'en' ? 'en' : 'zh-CN');
        document.getElementById('searchLink')?.setAttribute('aria-label', lang === 'en' ? 'Search' : '搜索');
        const appearance = document.getElementById('themeSelect') as HTMLSelectElement | null;
        if (appearance) {
          appearance.setAttribute('aria-label', lang === 'en' ? 'Appearance' : '外观');
          Array.from(appearance.options).forEach((option) => { option.textContent = ({ system: lang === 'en' ? 'System' : '跟随系统', light: lang === 'en' ? 'Light' : '浅色', dark: lang === 'en' ? 'Dark' : '深色' } as Record<string, string>)[option.value]; });
        }
        // <title> head-swap (two-way): pages with a static title supply
        // data-title-en. Swap to English in EN, restore the captured Chinese
        // SSR title in ZH — a one-way overwrite would leave the tab stuck in
        // English after EN→ZH. Pages without titleEn (API-derived titles:
        // posts, apps, podcast, tag/category details) have en === undefined,
        // so document.title is always set back to ssrTitle (their Chinese).
        const en = document.documentElement.dataset.titleEn;
        document.title = (en && lang === 'en') ? en : ssrTitle;
      }

      // Nav scroll border
      const nav = document.getElementById('nav');
      if (nav) {
        window.addEventListener('scroll', () => {
          nav.classList.toggle('scrolled', window.scrollY > 10);
        }, { passive: true });
      }

      // Apply i18n attribute translation for the active language on load
      // (the head bootstrap already set data-lang — we honour it). If a user
      // opens DevTools and rewrites data-lang the attributes stay stale; this
      // hook is the only one responsible for keeping aria/placeholder/title
      // in sync with the active language.
      const initialLang = (document.documentElement.getAttribute('data-lang') as Lang) || 'zh';
      applyAttrI18n(document, initialLang);
      // Head <title> swap on first load too (the head bootstrap can't run
      // applyLangToDom because it lives is:inline and must not import).
      applyLangToDom(initialLang);

      // Native select stays keyboard-accessible. Storage failure must never
      // disable appearance controls; the current page keeps an in-memory choice.
      const selector = document.getElementById('themeSelect') as HTMLSelectElement | null;
      const systemTheme = matchMedia('(prefers-color-scheme: dark)');
      let appearancePrefs = (() => { try { return readPrefs(localStorage.getItem(THEME_LS_KEY)); } catch { return {}; } })();
      function updateAppearance() {
        const theme = resolveTheme(appearancePrefs, systemTheme.matches);
        applyToDom(theme, resolveAccent(appearancePrefs, theme));
        if (selector) selector.value = themePreference(appearancePrefs);
      }
      selector?.addEventListener('change', () => {
        appearancePrefs = mergePrefs(appearancePrefs, { theme: selector.value as ThemePreference });
        try { localStorage.setItem(THEME_LS_KEY, JSON.stringify(appearancePrefs)); } catch { /* page-local preference */ }
        updateAppearance();
      });
      systemTheme.addEventListener('change', updateAppearance);
      window.addEventListener('storage', (event) => {
        if (event.key === THEME_LS_KEY || event.key === null) {
          appearancePrefs = readPrefs(event.newValue);
          updateAppearance();
        }
      });
      updateAppearance();

      // Language toggle button. Persists into the same norvyn-v2 blob as
      // theme/accent (the theme prefs read/write interface already carries
      // `lang` through mergePrefs; no extra localStorage key).
      const langBtn = document.getElementById('langBtn');
      if (langBtn) {
        langBtn.addEventListener('click', () => {
          const prefs = appearancePrefs;
          const saveLanguage = (lang: Lang) => {
            appearancePrefs = mergePrefs(prefs, { lang });
            try { localStorage.setItem(THEME_LS_KEY, JSON.stringify(appearancePrefs)); } catch { /* appearance stays available in memory */ }
          };
          const path = publicPathname(location.pathname);
          const onEn = isEnPath(path);
          // A bilingual page has a counterpart in the other language: /en pages
          // always do; a zh page only when it declared data-has-en-twin. There,
          // switching language NAVIGATES to the twin URL so chrome + body + URL
          // change together (not just the CSS chrome). Persist the explicit
          // choice so the destination honors it and the first-visit auto-redirect
          // (see the inline bootstrap) won't bounce the user back.
          const hasTwin = onEn || document.documentElement.getAttribute('data-has-en-twin') === 'true';
          if (hasTwin) {
            const targetLang: Lang = onEn ? 'zh' : 'en';
            saveLanguage(targetLang);
            location.assign(onEn ? stripEn(path) : enHref(path));
            return;
          }
          // Non-bilingual page (e.g. /podcast, which has no /en twin): keep the
          // original chrome-only flip — there is nowhere to navigate to.
          const current = (document.documentElement.getAttribute('data-lang') as Lang) || 'zh';
          const lang = nextLang(current);
          saveLanguage(lang);
          applyLangToDom(lang);
          applyAttrI18n(document, lang);
        });
      }

      // Mobile hamburger: toggles the nav-links dropdown (only visible ≤640px).
      // Closes on link tap, outside click, or Escape.
      const burger = document.getElementById('navBurger');
      if (nav && burger) {
        const setMenu = (open: boolean) => {
          nav.classList.toggle('menu-open', open);
          burger.setAttribute('aria-expanded', String(open));
        };
        burger.addEventListener('click', (e) => {
          e.stopPropagation();
          setMenu(!nav.classList.contains('menu-open'));
        });
        document.getElementById('navLinks')?.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) setMenu(false);
        });
        document.addEventListener('click', (e) => {
          if (nav.classList.contains('menu-open') && !nav.contains(e.target as Node)) setMenu(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setMenu(false);
        });
      }
    </script>

    <!-- Pageview beacon. Fires once per page load (MPA, no view transitions) and
         records a visit via the public analytics endpoint. Admin pages use a
         separate layout (AdminLayout), so backend traffic is excluded by design.
         Fire-and-forget: failures must never affect the page. -->
    <script>
      const apiUrl = document.body.dataset.apiUrl;
      if (apiUrl) {
        // Persistent anonymous browser id → real unique-visitor counts. Stored once
        // in localStorage and reused; never an IP, never PII. If storage/crypto is
        // blocked (private mode), fall through to an anonymous page view (no visitorId).
        let vid;
        try {
          vid = localStorage.getItem('wb_vid');
          if (!vid) {
            vid = (window.crypto && crypto.randomUUID)
              ? crypto.randomUUID()
              : 'v' + Date.now().toString(36) + Math.random().toString(36).slice(2, 10);
            localStorage.setItem('wb_vid', vid);
          }
        } catch (_) {
          vid = undefined;
        }
        fetch(`${apiUrl}/api/analytics/pageview`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            path: location.pathname,
            referrer: document.referrer || undefined,
            visitorId: vid || undefined,
          }),
          keepalive: true,
        }).catch(() => {});
      }
    </script>
  </body>
</html>

