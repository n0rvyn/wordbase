---
import '../styles/tokens.css';
import '../styles/admin-forms.css';
import '../styles/admin-dashboard.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';

const navItems = [
  { href: '/admin', label: 'Overview', group:'Workspace', icon: 'M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z' },
  { href: '/admin/observability', label: 'Observability', group:'Workspace', icon:'M4 19V9 M12 19V4 M20 19v-6' },
  { href: '/admin/posts', label: 'Posts', group:'Content', icon:'M5 3h11l3 3v15H5z M9 10h6 M9 14h6' },
  { href: '/admin/comments', label: 'Comments', group:'Content', icon:'M21 11a8 8 0 0 1-8 8H7l-4 3v-7a8 8 0 1 1 18-4z' },
  { href: '/admin/media', label: 'Media', group:'Content', icon:'M3 3h18v18H3z M3 16l5-5 5 5 3-3 5 5 M15 8h.01' },
  { href: '/admin/categories', label: 'Categories', group:'Content', icon:'M3 6h7l2 2h9v12H3z' },
  { href: '/admin/tags', label: 'Tags', group:'Content', icon:'M3 3h8l10 10-8 8L3 11z M7 7h.01' },
  { href: '/admin/settings', label: 'Settings', group:'Manage', icon:'M4 6h16 M4 12h16 M4 18h16 M8 3v6 M16 9v6 M10 15v6' },
];
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Wordbase Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <!-- FOUC-prevention bootstrap: read localStorage['norvyn-v2'] before paint.
         Mirrors BaseLayout's inline bootstrap so admin shares the same theme/accent
         preference as the public site. Keep in sync with src/lib/theme.ts. -->
    <script is:inline>
      (function() {
        var LS = 'norvyn-v2';
        var DEFAULT_THEME = 'light';
        var DEFAULT_ACCENT = '#3457B6';
        try {
          var stored = JSON.parse(localStorage.getItem(LS) || '{}');
          var theme = stored.theme || DEFAULT_THEME;
          var accent = stored.accent || DEFAULT_ACCENT;
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.style.setProperty('--accent', accent);
        } catch(e) {
          document.documentElement.setAttribute('data-theme', DEFAULT_THEME);
        }
      })();
    </script>
  </head>
  <body class="bg-paper min-h-screen"><a class="admin-skip" href="#main-content">Skip to content</a>
    <div class="flex min-h-screen flex-col md:flex-row">
      <aside class="admin-sidebar">
        <div class="admin-brand"><a href="/admin"><span class="admin-brand-mark" aria-hidden="true">w.</span><span>Wordbase<small>Site workspace</small></span></a><button id="admin-nav-toggle" aria-expanded="false" aria-controls="admin-navigation">Menu <span aria-hidden="true">☰</span></button></div>
        <nav id="admin-navigation" aria-label="Admin navigation">
          {['Workspace','Content','Manage'].map(group=><div class="admin-nav-group"><p>{group}</p>{navItems.filter(item=>item.group===group).map(item=>{
            const isActive=currentPath===item.href || (item.href!=='/admin' && currentPath.startsWith(item.href));
            return <a href={item.href} aria-current={isActive ? 'page' : undefined} class={isActive ? 'is-active' : ''}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon}/></svg>{item.label}</a>;
          })}</div>)}
        </nav>
        <div class="admin-sidebar-bottom"><a href="/" target="_blank" rel="noopener">View public site <span aria-hidden="true">↗</span></a><div><button id="logout-btn">Log out</button><button id="theme-btn" aria-label="Toggle theme"><svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg><svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.4M12 19.1v2.4M4.6 4.6l1.7 1.7M17.7 17.7l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.6 19.4l1.7-1.7M17.7 6.3l1.7-1.7"/></svg></button></div></div>
      </aside>
      <div class="admin-content">
        <header class="admin-topbar"><h1>{title === 'Dashboard' ? 'Overview' : title}</h1><span>Wordbase <span aria-hidden="true">/</span> Admin</span></header>
        <main class="admin-main" id="main-content"><slot /></main>
      </div>
    </div>

    <style is:global>
      /* moon/sun toggle: show the icon for the theme you'd switch TO. */
      .sun { display: none; }
      :root[data-theme="dark"] .sun { display: block; }
      :root[data-theme="dark"] .moon { display: none; }
    </style>

    <script>
      const menu = document.getElementById('admin-nav-toggle');
      menu?.addEventListener('click', () => {
        const open = menu.getAttribute('aria-expanded') !== 'true';
        menu.setAttribute('aria-expanded', String(open));
        document.querySelector('.admin-sidebar')?.classList.toggle('menu-open', open);
      });
      // Auth check
      if (!localStorage.getItem('wordbase_api_key') && !window.location.pathname.includes('/login')) {
        window.location.href = '/admin/login';
      }

      document.getElementById('logout-btn')?.addEventListener('click', () => {
        localStorage.removeItem('wordbase_api_key');
        window.location.href = '/admin/login';
      });
    </script>

    <!-- Theme toggle. Reuses the tested persistence helpers in src/lib/theme.ts
         (single source of truth) and the shared 'norvyn-v2' key, so toggling here
         also themes the public site. Mirrors BaseLayout's toggle script. -->
    <script>
      import {
        THEME_LS_KEY,
        DEFAULT_THEME,
        readPrefs,
        mergePrefs,
        nextTheme,
        resolveAccent,
      } from '../lib/theme';

      function applyToDom(theme: string, accent: string) {
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.setProperty('--accent', accent);
      }

      const btn = document.getElementById('theme-btn');
      if (btn) {
        btn.addEventListener('click', () => {
          const prefs = readPrefs(localStorage.getItem(THEME_LS_KEY));
          const current = document.documentElement.getAttribute('data-theme') || DEFAULT_THEME;
          const theme = nextTheme(current);
          const accent = resolveAccent(prefs);
          localStorage.setItem(THEME_LS_KEY, JSON.stringify(mergePrefs(prefs, { theme, accent })));
          applyToDom(theme, accent);
        });
      }
    </script>
  </body>
</html>
