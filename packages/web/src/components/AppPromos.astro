---
import type { PromotionalMedia } from '../lib/app';
import type { Locale } from '../lib/locale';
import PromotionalAnimation from './PromotionalAnimation.astro';
interface Props { items: PromotionalMedia[]; title: string; galleryId: string; locale: Locale; context?: 'catalog' | 'detail' }
const { items, title, galleryId, locale, context = 'catalog' } = Astro.props;
const en = locale === 'en';
const label = (index: number) => {
  const value = items[index].label;
  const common: Record<string, [string, string]> = { Overview: ['概览', 'Overview'], Workflow: ['操作流程', 'Workflow'], Examples: ['效果展示', 'Examples'] };
  return value && common[value] ? common[value][en ? 1 : 0] : value || `${en ? 'Preview' : '演示'} ${index + 1}`;
};
---
<div class="promo-gallery" data-promo-gallery data-context={context} aria-label={`${title} ${en ? 'previews' : '演示'}`}>
  <div class="promo-stage">
    {items.map((media, index) => <figure class="promo-panel" data-promo-panel id={`${galleryId}-${index}`} hidden={index !== 0}>
      <div class="promo-screen" data-shape={media.width && media.height && media.width >= media.height ? "wide" : "portrait"} style={media.width && media.height ? `--promo-ratio:${media.width}/${media.height}` : undefined}>
        {media.type === 'video' ? <video data-promo controls muted loop playsinline preload="none" poster={media.poster || undefined} width={media.width} height={media.height} aria-label={media.alt || `${title} ${label(index)}`}><source src={media.src} /></video>
          : media.type === 'animated-image' ? <PromotionalAnimation src={media.src} poster={media.poster!} alt={media.alt || `${title} ${label(index)}`} />
          : <img src={media.src} alt={media.alt || `${title} ${label(index)}`} width={media.width} height={media.height} loading="lazy" />}
        {context === 'catalog' && <button class="promo-visual-open" type="button" data-promo-visual data-promo-expand data-promo-title={`${title} · ${label(index)}`} aria-label={en ? `View ${title} preview` : `查看 ${title} 演示`} />}
      </div>
      <figcaption class="promo-actions">
        {media.type !== 'image' && <button type="button" data-promo-toggle aria-pressed="false">{en ? 'Play' : '播放'}</button>}
        <button type="button" data-promo-expand aria-label={`${en ? 'Expand' : '展开'} ${title} ${label(index)}`} data-promo-title={`${title} · ${label(index)}`}>{en ? 'Expand' : '展开'} ↗</button>
        {context === 'catalog' && items.length > 1 && <label class="promo-picker">
          <select data-promo-picker aria-label={`${title} ${en ? 'preview' : '演示'}`}>
            {items.map((_, choice) => <option value={choice} selected={choice === index}>{label(choice)}</option>)}
          </select>
        </label>}
      </figcaption>
    </figure>)}
  </div>
  {items.length > 1 && <div class="promo-selectors" role="group" aria-label={en ? 'Choose a preview' : '选择演示'}>
    {items.map((media, index) => <button type="button" data-promo-select={index} aria-controls={`${galleryId}-${index}`} aria-pressed={index === 0 ? 'true' : 'false'}><span>{String(index + 1).padStart(2, '0')}</span>{label(index)}</button>)}
  </div>}
  <dialog class="promo-modal" aria-label={`${title} ${en ? 'expanded preview' : '完整演示'}`}>
    <div class="promo-modal-bar"><h2 data-promo-modal-title></h2><button type="button" data-promo-close autofocus>{en ? 'Close' : '关闭'} ×</button></div>
    <div data-promo-modal-content></div>
  </dialog>
</div>
<style is:global>
  :root[data-public] .promo-picker,:root[data-public] .promo-visual-open { display:none; }
  :root[data-public] .promo-gallery { --promo-height:320px; width:100%; min-width:0; }
  :root[data-public] .promo-gallery[data-context="detail"] { --promo-height:min(520px,58svh); }
  :root[data-public] .ad-piece[data-has-promos] { background:none; border:0; padding:0; min-height:0; }
  :root[data-public] .promo-stage { background:color-mix(in srgb,var(--ink) 4%,var(--surface)); border:1px solid var(--line); border-radius:16px; padding:16px; }
  :root[data-public] .promo-panel { margin:0; width:100%; min-width:0; }
  :root[data-public] .promo-panel[hidden] { display:none !important; }
  :root[data-public] .promo-screen { display:flex; align-items:center; justify-content:center; width:100%; min-width:0; height:var(--promo-height); }
  :root[data-public] .promo-screen[data-shape="wide"] { height:auto; aspect-ratio:var(--promo-ratio,16/9); }
  :root[data-public] .promo-gallery .promo-screen :is(video,img,canvas) { display:block; width:100%; height:100%; max-width:100%; max-height:100%; object-fit:contain; border-radius:5px; }
  :root[data-public] .promo-gallery .promo-screen .studio-animation { width:100%; height:100%; }
  :root[data-public] .promo-gallery .promo-screen [hidden] { display:none !important; }
  :root[data-public] .promo-actions { display:flex; justify-content:center; gap:10px; margin-top:12px; flex-wrap:wrap; }
  :root[data-public] .promo-actions button,:root[data-public] .promo-modal-bar button { font:inherit; font-size:12px; color:var(--ink); background:var(--surface); border:1px solid var(--line-2); border-radius:8px; padding:10px 14px; min-height:44px; cursor:pointer; }
  :root[data-public] .promo-selectors { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
  :root[data-public] .promo-selectors button { display:flex; align-items:baseline; gap:8px; max-width:100%; overflow-wrap:anywhere; text-align:start; font:inherit; font-size:12px; border:1px solid var(--line); background:transparent; color:var(--ink-2); border-radius:9px; padding:10px 12px; min-height:44px; cursor:pointer; }
  :root[data-public] .promo-selectors button span { font:10px var(--font-mono,monospace); opacity:.65; }
  :root[data-public] .promo-selectors button[aria-pressed="true"] { border-color:var(--ink); color:var(--ink); background:color-mix(in srgb,var(--ink) 6%,var(--surface)); }
  :root[data-public] .promo-gallery button:focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
  :root[data-public] .promo-modal { width:min(1000px,calc(100vw - 32px)); max-width:calc(100vw - 32px); max-height:92svh; padding:16px; border:1px solid var(--line); border-radius:18px; background:var(--surface); color:var(--ink); }
  :root[data-public] .promo-modal::backdrop { background:#000b; }
  :root[data-public] .promo-modal-bar { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:16px; }
  :root[data-public] .promo-modal-bar h2 { font:inherit; font-size:15px; margin:0; }
  :root[data-public] .promo-modal .promo-screen { height:min(70svh,850px); }
  /* Catalog media shares the editorial two-column card instead of turning
     landscape promos into full-width panels that stretch the entire row. */
  :root[data-public] .studio-catalog .promo-gallery[data-context="catalog"] { --promo-height:250px; }
  :root[data-public] .studio-catalog .promo-gallery[data-context="catalog"] > .promo-stage { padding:0; border:0; border-radius:0; background:none; }
  :root[data-public] .studio-catalog .promo-gallery[data-context="catalog"] > .promo-stage > .promo-panel > .promo-actions { gap:6px; margin-top:8px; }
  :root[data-public] .studio-catalog .promo-gallery[data-context="catalog"] :is(.promo-actions,.promo-selectors) > button { display:inline-flex; align-items:center; justify-content:center; min-height:44px; line-height:1; }
  :root[data-public] .studio-catalog .promo-gallery[data-context="catalog"] > .promo-stage > .promo-panel > .promo-actions button { padding:0 8px; border-color:transparent; background:none; }
  :root[data-public] .studio-catalog .promo-gallery[data-context="catalog"] > .promo-selectors { margin-top:8px; }
  :root[data-public] .studio-catalog .promo-gallery[data-context="catalog"] > .promo-selectors button { padding:0 10px; }
  :root[data-public] .studio-catalog .promo-selectors button span { line-height:1; }
  /* Versions belong to the playback/expand strip at every catalog width. */
  :root[data-public] .studio-catalog .promo-gallery[data-context="catalog"] > .promo-selectors { display:none; }
  :root[data-public] .studio-catalog .promo-gallery[data-context="catalog"] .promo-actions { align-items:center; }
  :root[data-public] .studio-catalog .promo-gallery[data-context="catalog"] .promo-picker { display:block; margin:0; max-width:110px; }
  :root[data-public] .studio-catalog .promo-gallery[data-context="catalog"] .promo-picker select { width:auto; max-width:100%; min-width:0; min-height:44px; padding:0 6px; border:0; border-radius:0; background:transparent; color:var(--ink); font:inherit; font-size:12px; cursor:pointer; }
  @media(min-width:601px) {
    :root[data-public] .studio-catalog .studio-card[data-catalog-shape="wide"] { grid-template-columns:minmax(0,1fr) minmax(0,1fr); }
  }
  @media(max-width:560px) { :root[data-public] .studio-card[data-has-promos] { grid-template-columns:minmax(0,1fr); } :root[data-public] .promo-gallery { --promo-height:320px; } :root[data-public] .promo-gallery[data-context="detail"] { --promo-height:min(440px,58svh); } :root[data-public] .promo-stage { padding:12px; } }
</style>
<script>
  import { setupPromotionalPlayback } from '../lib/promotional-playback';
  const playback = setupPromotionalPlayback(document);
  document.querySelectorAll<HTMLElement>('[data-promo-gallery]').forEach(gallery => {
    const panels = Array.from(gallery.querySelectorAll<HTMLElement>('[data-promo-panel]'));
    const selectors = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-promo-select]'));
    const pickers = Array.from(gallery.querySelectorAll<HTMLSelectElement>('[data-promo-picker]'));
    const showPanel = (index: number) => {
      if (!Number.isInteger(index) || !panels[index]) return;
      panels.forEach((panel, i) => { panel.hidden = i !== index; });
      selectors.forEach((selector, i) => selector.setAttribute('aria-pressed', String(i === index)));
      pickers.forEach(picker => { picker.value = String(index); });
      const card = gallery.closest<HTMLElement>('[data-app-card]');
      if (card) card.dataset.catalogShape = panels[index].querySelector<HTMLElement>('.promo-screen')?.dataset.shape || 'portrait';
      playback.update();
    };
    selectors.forEach(button => button.addEventListener('click', () => showPanel(Number(button.dataset.promoSelect))));
    pickers.forEach(picker => picker.addEventListener('change', () => {
      const index = Number(picker.value);
      showPanel(index);
      pickers[index]?.focus();
    }));
    const dialog = gallery.querySelector<HTMLDialogElement>('.promo-modal')!;
    const content = dialog.querySelector<HTMLElement>('[data-promo-modal-content]')!;
    let opener: HTMLButtonElement | null = null;
    gallery.querySelectorAll<HTMLButtonElement>('[data-promo-expand]').forEach(button => button.addEventListener('click', () => {
      opener = button;
      dialog.querySelector('[data-promo-modal-title]')!.textContent = button.dataset.promoTitle || '';
      const screen = button.closest('[data-promo-panel]')!.querySelector('.promo-screen')!.cloneNode(true) as HTMLElement;
      screen.querySelector('[data-promo-visual]')?.remove();
      const expandedVideo = screen.querySelector('video');
      if (expandedVideo) { expandedVideo.setAttribute('data-promo-native-controls', ''); expandedVideo.controls = true; }
      const actions = document.createElement('div'); actions.className = 'promo-actions';
      if (screen.querySelector('video,[data-promo-animation]')) {
        const toggle = document.createElement('button'); toggle.type = 'button'; toggle.dataset.promoToggle = '';
        toggle.textContent = document.documentElement.dataset.lang === 'en' ? 'Play' : '播放'; actions.append(toggle);
      }
      content.replaceChildren(screen, actions); dialog.showModal(); playback.refresh();
    }));
    dialog.querySelector('[data-promo-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => {
      content.querySelectorAll('video').forEach(video => video.pause()); content.replaceChildren(); playback.refresh(); opener?.focus();
    });
  });
</script>
