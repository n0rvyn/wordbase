---
// Shared archives-page body. Single source of markup + scoped styles for the
// zh shell (pages/archives.astro) and the en shell (pages/en/archives.astro).
// Shells load + localize via lib/writing.loadArchivesData and pass the grouped
// posts here; this component is pure presentation. Locale only prefixes the
// post links with /en.
import { estimateReadTime, type Post } from '../../lib/api';
import { formatMonoDate } from '../../lib/home';
import type { YearGroup } from '../../lib/writing';
import { enHref, type Locale } from '../../lib/locale';
import T from '../T.astro';

interface Props {
  locale: Locale;
  groups: YearGroup[];
  totalPosts: number;
}

const { locale, groups, totalPosts } = Astro.props;
const lhref = (p: string) => (locale === 'en' ? enHref(p) : p);
---

<header class="archive-header wrap">
  <div><span class="archive-label">THE WRITING / ARCHIVE</span><h1><T k="archives.h1" /></h1><p><T zh={`${totalPosts} 篇文章，按时间倒序。`} en={`${totalPosts} posts, newest first.`} /></p></div>
  <label class="archive-search"><span><T zh="查找文章" en="Find an article" /></span><input type="search" id="archiveSearch" placeholder={locale === 'en' ? 'Search titles…' : '搜索标题…'} /></label>
</header>
<nav class="archive-years wrap" aria-label={locale === 'en' ? 'Jump to year' : '按年份浏览'}>{groups.map(group => <a href={`#year-${group.year}`}>{group.year || (locale === 'en' ? 'Undated' : '未注明日期')}<span>{group.posts.length}</span></a>)}</nav>
<section class="archive-index wrap" aria-label={locale === 'en' ? 'Articles' : '文章'}>
  {groups.map(group => <section class="archive-year" id={`year-${group.year}`}><h2>{group.year || (locale === 'en' ? 'Undated' : '未注明日期')}</h2><div class="archive-rows">{group.posts.map((post: Post) => <a class="archive-entry" data-archive-title={post.title.toLocaleLowerCase()} href={lhref(`/posts/${post.slug}`)}>
    <time>{post.publishedAt ? formatMonoDate(post.publishedAt) : '—'}</time><span>{post.title}</span><small>{estimateReadTime(post.content)} min</small>
  </a>)}</div></section>)}
  <p id="archiveEmpty" hidden><T zh="没有匹配的文章。" en="No matching articles." /></p>
</section>
<script>
  const input = document.getElementById('archiveSearch') as HTMLInputElement;
  input.addEventListener('input', () => {
    const query = input.value.trim().toLocaleLowerCase(); let count = 0;
    document.querySelectorAll<HTMLElement>('[data-archive-title]').forEach(row => { row.hidden = !row.dataset.archiveTitle!.includes(query); if (!row.hidden) count++; });
    document.querySelectorAll<HTMLElement>('.archive-year').forEach(year => { year.hidden = !year.querySelector('[data-archive-title]:not([hidden])'); });
    document.getElementById('archiveEmpty')!.hidden = count > 0;
  });
</script>
<style>
  .archive-header { display: flex; justify-content: space-between; align-items: end; gap: 32px; padding: 32px 0 24px; }
  .archive-label { color: var(--ink-2); font-size: 10px; letter-spacing: .12em; }
  .archive-header h1 { font: 500 clamp(28px,3vw,38px)/1.2 var(--font-display); letter-spacing: -.03em; margin: 10px 0; }
  .archive-header p { color: var(--ink-2); font-size: 14px; }
  .archive-search { display: flex; flex-direction: column; gap: 6px; font-size: 12px; }
  .archive-search input { min-height: 44px; padding: 10px 14px; border: 1px solid var(--line); border-radius: 5px; background: var(--surface); color: var(--ink); max-width: 100%; }
  .archive-years { display: flex; flex-wrap: wrap; gap: 12px 28px; border-block: 1px solid var(--line); padding-block: 14px; }
  .archive-years a { font-size: 14px; padding-block: 4px; }
  .archive-years span { font-size: 11px; color: var(--ink-2); margin-left: 10px; }
  .archive-year { display: grid; grid-template-columns: 80px minmax(0,1fr); gap: 32px; padding-top: 24px; scroll-margin-top: 20px; }
  .archive-year h2 { font: 500 20px var(--font-display); }
  .archive-rows { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0 32px; }
  .archive-entry { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 4px 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .archive-entry time { grid-column: 1 / -1; color: var(--ink-2); font-size: 11px; }
  .archive-entry span { font-size: 16px; line-height: 1.5; }
  .archive-entry small { font-size: 11px; color: var(--ink-2); align-self: center; }
  .archive-entry:hover span { color: var(--accent); }
  @media(max-width:760px) { .archive-rows { grid-template-columns: 1fr; } .archive-year { grid-template-columns: 1fr; gap: 10px; } }
  @media(max-width:560px) { .archive-header { align-items: start; flex-direction: column; gap: 14px; padding-top: 24px; } .archive-search { width: 100%; } .archive-search input { width: 100%; } .archive-year { padding-top: 20px; } .archive-years { flex-wrap: nowrap; overflow-x: auto; white-space: nowrap; } .archive-years a { flex-shrink: 0; } }
</style>
