---
// Shared categories-index body for pages/categories/index.astro (zh) and
// pages/en/categories/index.astro (en). Category names are not translated, so
// the only locale effect is the /en link prefix. Shells fetch categories +
// per-category counts and pass them in.
import { decodeEntities } from '../../lib/home';
import type { Category } from '../../lib/api';
import { enHref, type Locale } from '../../lib/locale';
import T from '../T.astro';
import IndexHeader from '../IndexHeader.astro';

interface Props {
  locale: Locale;
  categories: Category[];
  catCounts: Map<string, number>;
}

const { locale, categories, catCounts } = Astro.props;
const lhref = (p: string) => (locale === 'en' ? enHref(p) : p);
---

<IndexHeader>
  <span slot="label"><T k="cat.index.eyebrow" /></span>
  <span slot="title"><T k="cat.index.h1" /></span>
  <span slot="summary"><T zh={`${categories.length} 个分类，按主题浏览文章。`} en={`${categories.length} categories to explore the writing.`} /></span>
</IndexHeader>
<section class="categories-index wrap" aria-label={locale === 'en' ? 'All categories' : '全部分类'}>
  {categories.length === 0 ? <p class="categories-empty"><T k="cat.index.empty" /></p> : (
    <div class="categories-grid">
      {categories.map((cat: Category) => (
        <a class="category-entry" href={lhref(`/categories/${cat.slug}`)}>
          <div class="category-copy"><h2>{decodeEntities(cat.name)}</h2>{cat.description && <p>{cat.description}</p>}</div>
          <span class="category-count"><T zh={`${catCounts.get(cat.slug) ?? 0} 篇`} en={`${catCounts.get(cat.slug) ?? 0} posts`} /><span class="category-arrow" aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>
  )}
</section>
<style>
  .categories-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); column-gap: 48px; border-top: 1px solid var(--line); }
  .category-entry { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 88px; padding-block: 20px; border-bottom: 1px solid var(--line); }
  .category-copy { min-width: 0; }
  .category-copy h2 { font: 500 19px/1.4 var(--font-display); letter-spacing: -.02em; margin: 0; overflow-wrap: anywhere; }
  .category-copy p { font-size: 13px; color: var(--ink-2); line-height: 1.6; margin-top: 5px; }
  .category-count { display: flex; align-items: center; gap: 16px; white-space: nowrap; font-size: 12px; color: var(--ink-2); }
  .category-arrow { font-size: 17px; color: var(--ink-2); }
  .category-entry:hover h2, .category-entry:hover .category-arrow { color: var(--accent); }
  .category-entry:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .categories-empty { padding-block: 30px; color: var(--ink-2); }
  @media(max-width:760px) { .categories-grid { grid-template-columns: 1fr; } }
  @media(max-width:560px) { .category-entry { min-height: 76px; padding-block: 16px; gap: 14px; } .category-copy h2 { font-size: 17px; } .category-count { gap: 10px; } }
</style>
