---
// Shared category-detail body for pages/categories/[slug].astro (zh) and
// pages/en/categories/[slug].astro (en). getStaticPaths stays in the shells
// (Astro requires it in the route file); the shells fetch + (en) localize the
// posts and pass them in. Locale only prefixes the post links with /en.
import { estimateReadTime, stripMarkdown, type Post } from '../../lib/api';
import { formatMonoDate } from '../../lib/home';
import { enHref, type Locale } from '../../lib/locale';
import T from '../T.astro';
import IndexHeader from '../IndexHeader.astro';

interface Props {
  locale: Locale;
  catName: string;
  description: string | null;
  posts: Post[];
}

const { locale, catName, description, posts } = Astro.props;
const lhref = (p: string) => (locale === 'en' ? enHref(p) : p);
---

<IndexHeader>
  <span slot="label"><T k="cat.detail.eyebrow" /></span>
  <span slot="title">{catName}</span>
  <span slot="summary"><T zh={`${posts.length} 篇文章。`} en={`${posts.length} posts.`} /></span>
  {description && <span slot="description">{description}</span>}
</IndexHeader>

<section class="index-results wrap">
      {posts.length === 0 ? (
        <div class="empty"><T k="cat.detail.empty" /></div>
      ) : (
        <div class="list">
          {posts.map((p: Post) => (
            <a class="item post" href={lhref(`/posts/${p.slug}`)}>
              <div>
                {p.publishedAt && <div class="pdate">{formatMonoDate(p.publishedAt)}</div>}
                <div class="item-title">{p.title}</div>
                <div class="item-sub">{p.excerpt || stripMarkdown(p.content, 120)}</div>
              </div>
              <div class="item-meta">{estimateReadTime(p.content)} min</div>
            </a>
          ))}
        </div>
      )}
</section>

<style>
  .index-results { border-top: 1px solid var(--line); }
  .empty { color: var(--ink-2); font-size: 16px; padding: 24px 0; }
  /* ── Full-density post rows ───────────────────────────────────────────────── */
  .post { grid-template-columns: 1fr auto; gap: 6px 28px; }
  .post .item-title { font-size: clamp(19px, 2vw, 24px); margin-bottom: 6px; }
  .pdate {
    font-family: var(--font-mono); font-size: 12px;
    color: var(--ink-3); margin-bottom: 9px;
  }
  .post .item-sub { font-size: 15px; }
  .post .item-meta { align-self: start; padding-top: 2px; }
</style>
