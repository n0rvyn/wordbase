---
// Shared tags-index body for pages/tags/index.astro (zh) and
// pages/en/tags/index.astro (en). Tag names are not translated, so the only
// locale effect is the /en link prefix.
import { decodeEntities } from '../../lib/home';
import type { Tag } from '../../lib/api';
import { enHref, type Locale } from '../../lib/locale';
import T from '../T.astro';
import IndexHeader from '../IndexHeader.astro';

interface Props {
  locale: Locale;
  tags: Tag[];
}

const { locale, tags } = Astro.props;
const lhref = (p: string) => (locale === 'en' ? enHref(p) : p);
---

<IndexHeader>
  <span slot="label"><T k="tag.index.eyebrow" /></span>
  <span slot="title"><T k="tag.index.h1" /></span>
  <span slot="summary"><T zh={`${tags.length} 个标签。`} en={`${tags.length} tags.`} /></span>
</IndexHeader>
<section class="tags-index wrap" aria-label={locale === 'en' ? 'All tags' : '全部标签'}>
  {tags.length === 0 ? <p class="empty"><T k="tag.index.empty" /></p> : <div class="tag-cloud">{tags.map((tag: Tag) => <a class="chip-f" href={lhref(`/tags/${tag.slug}`)}>{decodeEntities(tag.name)}</a>)}</div>}
</section>
<style>
  .tags-index { border-top: 1px solid var(--line); padding-top: 22px; }
  .empty { color: var(--ink-2); padding: 24px 0; }
  /* ── Tag cloud ────────────────────────────────────────────────────────────── */
  .tag-cloud {
    display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
  }
  .chip-f {
    font-family: var(--font-mono); font-size: 13px; letter-spacing: .02em;
    color: var(--ink-2); background: transparent;
    border: 1px solid var(--line-2); border-radius: 99px; padding: 10px 15px; max-width: 100%; overflow-wrap: anywhere;
    transition: all .2s var(--ease); display: inline-block;
  }
  .chip-f:hover { border-color: var(--ink-3); color: var(--ink); }
</style>
