---
import { stripMarkdown, type Post } from '../../lib/api';
import { groupByYear, type WritingIndexData } from '../../lib/writing';
import { enHref, type Locale } from '../../lib/locale';
import T from '../T.astro';

interface Props extends WritingIndexData { locale: Locale; }
const { locale, topCats, featuredVariants, groups, postCatSlugs, catNameById } = Astro.props;
const lhref = (path: string) => locale === 'en' ? enHref(path) : path;
const first = featuredVariants.find(variant => variant.key === 'all')?.post;
const posts: Post[] = [ ...(first ? [first] : []), ...groups.flatMap(group => group.posts) ];
const featured = posts.slice(0, 3);
const archive = groupByYear(posts);
const day = (timestamp: number | null) => timestamp ? String(new Date(timestamp * 1000).getUTCDate()).padStart(2, '0') : '—';
const month = (timestamp: number | null) => timestamp ? new Date(timestamp * 1000).toISOString().slice(0,7).replace('-', '.') : '';
---
<header class="journal-hero wrap">
  <div class="universe-eyebrow"><span>01 / THE JOURNAL</span></div>
  <div class="journal-heading"><div><p class="journal-kicker"><T zh="观察 · 制作 · 反思" en="Observe · make · reflect" /></p><h1><T zh="留一点，给思考。" en="A little room for thought." /></h1></div><div><p><T zh="开发中的取舍，生活里的观察。" en="Tradeoffs in making. Observations from living." /></p><a href="/rss.xml"><T zh="订阅 RSS" en="Subscribe via RSS" /> ↗</a></div></div>
</header>
{featured.length > 0 && <section class="journal-featured wrap" aria-label={locale === 'en' ? 'Recent writing' : '最近的文章'}>
  {featured.map((post,index) => <a class:list={['journal-feature', { 'journal-feature-main': index === 0 }]} href={lhref(`/posts/${post.slug}`)}>
    <div class="journal-feature-meta"><span>{catNameById.get(post.id) || (locale === 'en' ? 'Essay' : '随笔')}</span><time datetime={post.publishedAt ? new Date(post.publishedAt * 1000).toISOString() : undefined}>{month(post.publishedAt)}{post.publishedAt ? `.${day(post.publishedAt)}` : ''}</time></div>
    <h2>{post.title}</h2>
    {index === 0 && <p>{post.excerpt || stripMarkdown(post.content, 140)}</p>}
    <span class="journal-feature-link"><T zh="阅读这篇" en="Read this story" /> ↗</span>
  </a>)}
</section>}
<section class="journal-archive wrap" aria-labelledby="journalArchive">
  <div class="journal-index-head"><div><h2 id="journalArchive"><span aria-hidden="true">✳</span><T zh="文章索引" en="The writing index" /></h2><p><T zh="沿着一个问题，继续读下去。" en="Follow a question. See where it takes you." /></p></div><label class="studio-search"><span><T zh="找文章" en="Find a story" /></span><input type="search" id="blogSearch" placeholder={locale === 'en' ? 'Search titles…' : '搜索文章标题…'} /></label></div>
  <div class="journal-filter-row"><div class="studio-filters journal-filters" role="group" aria-label={locale === 'en' ? 'Filter by category' : '按分类筛选'}><button type="button" data-cat="all" aria-pressed="true"><T zh="全部" en="All" /></button>{topCats.map(cat => <button type="button" data-cat={cat.slug} aria-pressed="false">{cat.name}</button>)}</div><span id="blogCount" aria-live="polite">{posts.length} <T zh="篇文章" en="stories" /></span></div>
  <div id="postList">{archive.map(group => <section class="journal-year" data-journal-year><h3 class="journal-year-label">{group.year || (locale === 'en' ? 'Undated' : '未注明日期')}</h3><div class="journal-rows">{group.posts.map(post => <a class="journal-row" href={lhref(`/posts/${post.slug}`)} data-journal-post data-cats={(postCatSlugs.get(post.id) || []).join(' ')} data-search={post.title}>
    <time datetime={post.publishedAt ? new Date(post.publishedAt * 1000).toISOString() : undefined}><span>{day(post.publishedAt)}</span><span>{month(post.publishedAt)}</span></time>
    <div><span class="journal-row-category">{catNameById.get(post.id) || (locale === 'en' ? 'Essay' : '随笔')}</span><h3>{post.title}</h3></div><span class="journal-row-arrow" aria-hidden="true">↗</span>
  </a>)}</div></section>)}</div>
  <p id="blogEmpty" class="studio-empty" hidden><T zh="没有找到匹配的文章。换个关键词试试。" en="No matching stories. Try another search." /></p>
  <a class="journal-all-categories" href={lhref('/categories')}><T zh="浏览全部分类" en="Browse all categories" /> ↗</a>
</section>
<script>
  const search = document.getElementById('blogSearch') as HTMLInputElement | null;
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.journal-filters button'));
  const posts = Array.from(document.querySelectorAll<HTMLElement>('[data-journal-post]'));
  let category = 'all';
  function filterWriting() {
    const query = (search?.value || '').trim().toLocaleLowerCase();
    let count = 0;
    posts.forEach(post => {
      const show = (category === 'all' || (post.dataset.cats || '').split(' ').includes(category)) && (post.dataset.search || '').toLocaleLowerCase().includes(query);
      post.hidden = !show;
      if (show) count++;
    });
    document.querySelectorAll<HTMLElement>('[data-journal-year]').forEach(year => { year.hidden = !year.querySelector('[data-journal-post]:not([hidden])'); });
    const countLabel = document.getElementById('blogCount');
    if (countLabel) countLabel.textContent = `${count} ${document.documentElement.dataset.lang === 'en' ? (count === 1 ? 'story' : 'stories') : '篇文章'}`;
    const empty = document.getElementById('blogEmpty');
    if (empty) empty.hidden = count !== 0;
  }
  search?.addEventListener('input', filterWriting);
  filters.forEach(button => button.addEventListener('click', () => {
    category = button.dataset.cat || 'all';
    filters.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    filterWriting();
  }));
</script>
