---
// Shared companion-page body for pages/[slug].astro (zh) and
// pages/en/[slug].astro (en). Companion pages have no internal navigation, so
// the body is locale-identical — the shells parse the (localized) markdown and
// pass the title + rendered HTML. prose.css is imported here so every consumer
// gets the prose styling.
import '../../styles/prose.css';

interface Props {
  title: string;
  htmlContent: string;
}

const { title, htmlContent } = Astro.props;
// Tables need a real scroll container: overflow on a CSS table does not
// constrain its intrinsic minimum width. Keep all authored cells and links.
const tableLabel = Astro.url.pathname.startsWith('/en/') ? 'Scrollable table' : '可横向滚动的表格';
const readableHtml = htmlContent.replace(/<table\b[\s\S]*?<\/table>/gi, table => `<div class="legal-table-scroll" tabindex="0" role="region" aria-label="${tableLabel}">${table}</div>`);
---

<article class="companion-document">
  <header><h1>{title}</h1></header>
  <div class="prose" set:html={readableHtml} />
</article>

<style>
  .companion-document { max-width: 760px; margin: 40px auto 0; }
  .companion-document header { padding-bottom: 24px; border-bottom: 1px solid var(--line); }
  .companion-document h1 { font: 500 clamp(26px,3vw,36px)/1.3 var(--font-display); letter-spacing: -.025em; color: var(--ink); margin: 0; }
  .companion-document .prose { max-width: none; margin-top: 28px; color: var(--ink); font: 16px/1.85 var(--font-read); --tw-prose-headings: var(--ink); --tw-prose-bold: var(--ink); --tw-prose-code: var(--ink); --tw-prose-counters: var(--ink-2); --tw-prose-bullets: var(--ink-3); --tw-prose-th-borders: var(--line-2); --tw-prose-td-borders: var(--line); }
  .companion-document :global(.prose :is(h1,h2,h3,h4,h5,h6,th,td)) { color: var(--ink); }
  .companion-document :global(.prose h2) { font-size: 23px; line-height: 1.4; margin-top: 1.8em; }
  .companion-document :global(.prose h3) { font-size: 19px; line-height: 1.45; }
  .companion-document :global(.prose a) { color: #a7381c; }
  :global([data-theme="dark"]) .companion-document :global(.prose a) { color: #ffb291; }
  .companion-document :global(.legal-table-scroll) { max-width: 100%; overflow-x: auto; margin-block: 24px; }
  .companion-document :global(.legal-table-scroll table) { width: 100%; min-width: 480px; margin: 0; font-size: 14px; line-height: 1.65; }
  .companion-document :global(.prose code) { overflow-wrap: anywhere; color: var(--ink); }
  @media(max-width:600px) { .companion-document { margin-top: 28px; } .companion-document .prose { font-size: 16px; line-height: 1.8; } }
</style>
