---
import T from '../T.astro';
import { getSiteIdentity } from '../../lib/api';
import { resolveSiteCopy } from '../../lib/site-copy';
import { type Post, type App, type Episode, type Podcast } from '../../lib/api';
import { formatMonoDate, decodeEntities } from '../../lib/home';
import { enHref, type Locale } from '../../lib/locale';

interface Props {
  locale: Locale;
  posts: Post[];
  postCat: Map<string, string> | null;
  apps: App[];
  podcast: Podcast | null;
  episodes: Episode[];
}
const { locale, posts, apps, podcast, postCat } = Astro.props;
const lhref = (path: string) => locale === 'en' ? enHref(path) : path;

const copy = resolveSiteCopy((await getSiteIdentity()).copy);
const artApps = apps.filter(app => app.icon).slice(0, 3);
---

<header class="universe-hero wrap">
  <div class="universe-eyebrow"><span>{copy.eyebrow}</span><span>NORVYN.COM</span></div>
  <h1>{copy.headline}<br />{copy.headlineLead} <em>{copy.headlineAccent}</em></h1>
  <div class="universe-intro">
    <p style="white-space: pre-line"><span class="i18n"><span data-l="zh">{copy.introZh}</span><span data-l="en">{copy.introEn}</span></span></p>
    <a href="#spaces"><T zh="三个入口，同一个我" en="Three spaces. One curious mind." /><span aria-hidden="true">↓</span></a>
  </div>
</header>

<section class="universe-portals wrap" id="spaces" aria-label={locale === 'en' ? 'Explore my work' : '探索我的作品'}>
  <a class="portal portal-words" href={lhref('/writing')}>
    <div class="portal-top"><span>01 / WORDS</span><span>blog ↗</span></div>
    <div class="portal-art paper-art" aria-hidden="true"><span>Aa.</span><b>NOTES ON THE WAY</b><i></i><i></i><i></i></div>
    <div class="portal-label"><h2><T zh="想法，留下来。" en="Thoughts, kept." /></h2><p><T zh="写作 / 观察 / 开发日志" en="Essays / observations / dev notes" /></p><span aria-hidden="true">↗</span></div>
  </a>
  <a class="portal portal-sound" href="/podcast">
    <div class="portal-top"><span>02 / SOUND</span><span>podcast ↗</span></div>
    <div class="portal-art record-art" aria-hidden="true"><div class="record-center">拾<br />余光</div></div>
    <div class="portal-label"><h2><T zh="听见，另一面。" en="Another side, heard." /></h2><p>{podcast ? decodeEntities(podcast.title) : '拾余光'}<T zh=" · 在声音里慢下来" en=" · Take your time. Listen." /></p><span aria-hidden="true">↗</span></div>
  </a>
  <a class="portal portal-objects" href={lhref('/apps')}>
    <div class="portal-top"><span>03 / OBJECTS</span><span>apps ↗</span></div>
    <div class="portal-art object-art" aria-hidden="true">
      {artApps.length ? artApps.map((app, index) => <img class={`object-icon object-${index}`} src={app.icon!} alt="" width="128" height="128" />) : <span class="object-letter">n<span>✳</span></span>}
    </div>
    <div class="portal-label"><h2><T zh="小事，做好。" en="Small things, well made." /></h2><p><T zh="独立应用 / 日常工具" en="Independent apps / everyday tools" /></p><span aria-hidden="true">↗</span></div>
  </a>
</section>

<div class="home-latest wrap"><section class="universe-recent" id="writing">
  <div class="universe-section-head"><h2><T zh="最近留下的痕迹" en="Recent traces" /></h2><a href={lhref('/writing')}><T zh="全部文章" en="All writing" /> ↗</a></div>
  <div class="trace-list">
    {posts.slice(0, 3).map(post => <a class="trace" href={lhref(`/posts/${post.slug}`)}>
      <time datetime={post.publishedAt ? new Date(post.publishedAt * 1000).toISOString() : undefined}>{post.publishedAt ? formatMonoDate(post.publishedAt) : '—'}</time>
      <h3>{post.title}</h3><span class="trace-meta">{postCat?.get(post.id) || (locale === 'en' ? 'Essay' : '随笔')}</span><span class="trace-arrow" aria-hidden="true">↗</span>
    </a>)}
  </div>
</section>

<section class="universe-credo">
  <p class="credo-title">Less noise.<br /><em>More meaning.</em></p>
  <div><p><T zh="代码、文字和声音，可以是同一种表达。让每一件小事，都有自己的分量。" en="Code, words, and sound can be the same kind of expression. A little care gives small things their own weight." /></p><span><T zh="持续创作，慢慢生长" en="Keep making. Grow slowly." /></span></div>
</section>

</div>
