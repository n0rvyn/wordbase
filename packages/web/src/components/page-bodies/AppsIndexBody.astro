---
import { type App } from '../../lib/api';
import { displayName, heroShot, parseJsonArray, storeHref, promotionalMediaList } from '../../lib/app';
import AppPromos from '../AppPromos.astro';
import '../../styles/apps-catalog-mobile.css';
import { enHref, type Locale } from '../../lib/locale';
import T from '../T.astro';
import { publicProjects } from '../../lib/public-projects';

interface Props { locale: Locale; apps: App[]; }
const { locale, apps } = Astro.props;
const en = locale === 'en';
const lhref = (path: string) => en ? enHref(path) : path;
const availablePlatforms = [...new Set(apps.map(app => app.platform).filter(Boolean))];
const platforms = [...new Set(['iOS', 'macOS', 'Web', ...availablePlatforms])].filter(platform => availablePlatforms.includes(platform));
function linksFor(app: App): Record<string, string> {
  try {
    const links = JSON.parse(app.links || '{}');
    if (!links || typeof links !== 'object' || Array.isArray(links)) return {};
    return Object.fromEntries(Object.entries(links).filter((entry): entry is [string,string] => typeof entry[1] === 'string' && /^https?:\/\//i.test(entry[1])));
  } catch { return {}; }
}
const catalog = apps.map((app, index) => ({
  app, index, title: displayName(app.name), detail: lhref(`/apps/${app.slug}`),
  store: storeHref(app), links: linksFor(app),
  shot: heroShot(parseJsonArray<string>(app.screenshots), app.platform),
  media: promotionalMediaList(app.meta), description: app.tagline || app.subtitle,
}));
---
<header class="studio-hero wrap">
  <div class="universe-eyebrow"><span>03 / THE SMALL SOFTWARE STUDIO</span></div>
  <h1><T zh="小工具，认真做。" en="Small tools. Made with care." /></h1>
  <div class="studio-intro"><p><T zh="看看它能做什么，再决定它是否适合你。" en="See what it does. Find what fits your day." /></p><a href="#public-projects"><T zh="公开项目" en="Public projects" /> ↓</a></div>
</header>
<section class="studio-catalog wrap" aria-label={en ? 'App catalog' : '应用目录'}>
  <div class="studio-toolbar">
    <div class="studio-filters" role="group" aria-label={en ? 'Filter by platform' : '按平台筛选'}>
      <button type="button" data-platform="all" aria-pressed="true"><T zh="全部" en="All" /></button>
      {platforms.map(platform => <button type="button" data-platform={platform} aria-pressed="false">{platform}</button>)}
    </div>
    <label class="studio-search"><span><T zh="搜索应用" en="Find an app" /></span><input type="search" id="appSearch" placeholder={en ? 'Name or purpose…' : '应用名或用途…'} /></label>
  </div>
  <p class="studio-count" id="appCount" aria-live="polite" data-count-zh="款应用" data-count-en="apps">{apps.length} <T zh="款应用" en="apps" /></p>
  <div class="studio-grid" id="appGrid">
    {catalog.map(({ app, index, title, detail, store, links, shot, media, description }) => <article class="studio-card" style={`--app-tint:${/^#[0-9a-f]{6}$/i.test(app.accentColor || '') ? app.accentColor : '#a5b1a4'}`} data-app-card data-app-slug={app.slug} data-catalog-shape={media.length ? (media[0].width && media[0].height && media[0].width >= media[0].height ? "wide" : "portrait") : shot ? (shot.width && shot.height ? (shot.width >= shot.height ? "wide" : "portrait") : app.platform === "iOS" ? "portrait" : "wide") : "wide"} data-has-promos={media.length ? "" : undefined} data-promo-layout={media.some(item => item.width && item.height && item.width >= item.height) ? "wide" : undefined} data-platform={app.platform} data-search={`${app.name} ${app.tagline || ''} ${app.subtitle || ''} ${app.description || ''}`}>
        <div class="studio-copy">
          <div class="studio-identity">
          <div class="studio-icon">{app.icon ? <img src={app.icon} alt="" width="52" height="52" loading="lazy" /> : <span>{title.charAt(0)}</span>}</div>
          <p class="studio-platform"><span class="studio-platform-desktop">{String(index + 1).padStart(2, '0')} / {app.platform}</span><span class="studio-platform-mobile">{app.platform}{store ? ' · App Store' : ''}</span></p>
          <h2><a href={detail}>{title}</a></h2>
          </div>
          <div class="studio-summary">
          {app.platform === 'Web' && app.subtitle && <p class="studio-access">{app.subtitle}</p>}
          {description && <p class="studio-description">{description}</p>}
          </div>
          <div class="studio-card-links">
            <div class="studio-actions">
              {store && <a href={store} target="_blank" rel="noopener noreferrer">App Store ↗</a>}
              {links.support && <a href={links.support}><T zh="支持" en="Support" /></a>}
              {links.privacy && <a href={links.privacy}><T zh="隐私" en="Privacy" /></a>}
            </div>
          </div>
        </div>
        <div class="studio-media">
          {media.length ? <AppPromos items={media} title={title} galleryId={`catalog-${app.id}`} locale={locale} /> : shot ? <button class="studio-shot" type="button" data-expand-image={shot.url} data-title={title} aria-label={en ? `View ${title} screenshot` : `查看 ${title} 截图`}>
            <img src={shot.url} alt={en ? `${title} screenshot` : `${title} 截图`} width={shot.width ?? undefined} height={shot.height ?? undefined} loading="lazy" />
            <span><T zh="查看截图" en="View screenshot" /> ↗</span>
          </button> : <div class="studio-no-media" aria-hidden="true">{title.charAt(0)}<span>✳</span></div>}
        </div>
      </article>)}
  </div>
  <p class="studio-empty" id="appEmpty" hidden><T zh="没有找到匹配的应用。换个关键词试试。" en="No matching apps. Try another search." /></p>
</section>
<section class="studio-projects wrap" id="public-projects">
  <div class="universe-eyebrow"><span>THE OPEN WORKBENCH / PUBLIC GITHUB</span></div>
  <div class="studio-projects-intro"><div><h2><T zh="也把工具，留给别人。" en="A few tools, left open." /></h2><p><T zh="应用之外，还有插件、开发工具与实验。" en="Beyond the apps: plugins, developer tools, and experiments." /></p></div><a href="https://github.com/n0rvyn" target="_blank" rel="noopener noreferrer">GitHub / n0rvyn ↗</a></div>
  <div class="studio-toolbar">
    <div class="project-filters studio-filters" role="group" aria-label={en ? 'Filter projects' : '筛选项目'}>
      <button type="button" data-project-category="active" aria-pressed="true"><T zh="非归档 · 非 Fork" en="Non-archived · non-fork" /></button>
      <button type="button" data-project-category="all" aria-pressed="false"><T zh="全部" en="All" /></button>
      <button type="button" data-project-category="plugin" aria-pressed="false"><T zh="插件" en="Plugins" /></button>
      <button type="button" data-project-category="tool" aria-pressed="false"><T zh="工具与库" en="Tools & libraries" /></button>
      <button type="button" data-project-category="app" aria-pressed="false"><T zh="应用" en="Apps" /></button>
      <button type="button" data-project-category="experiment" aria-pressed="false"><T zh="实验" en="Experiments" /></button>
      <button type="button" data-project-category="archived" aria-pressed="false"><T zh="归档" en="Archived" /></button>
      <button type="button" data-project-category="fork" aria-pressed="false">Fork</button>
    </div>
    <label class="studio-search"><span><T zh="查找项目" en="Find a project" /></span><input type="search" id="projectSearch" placeholder={en ? 'Name or purpose…' : '项目名或用途…'} /></label>
  </div>
  <p class="studio-count" id="projectCount" aria-live="polite">{publicProjects.filter(project => !project.archived && !project.fork).length} <T zh="个项目" en="projects" /></p>
  <div class="project-grid">
    {publicProjects.map(project => <article class="project-card" data-project-card data-category={project.category} data-archived={String(project.archived)} data-fork={String(project.fork)} hidden={project.archived || project.fork} data-search={`${project.name} ${project.zh} ${project.en}`}>
      <span class="project-category"><T zh={project.categoryZh} en={project.categoryEn} />{project.archived && <span> · <T zh="归档" en="Archived" /></span>}{project.fork && <span> · Fork</span>}</span>
      <h3><a href={project.url} target="_blank" rel="noopener noreferrer">{project.name} <span aria-hidden="true">↗</span></a></h3>
      <p><T zh={project.zh} en={project.en} /></p><span class="project-language">{project.language}</span>
      <a class="project-open" href={project.url} target="_blank" rel="noopener noreferrer"><T zh="查看仓库" en="View repository" /> ↗</a>
    </article>)}
  </div>
  <p class="studio-empty" id="projectEmpty" hidden><T zh="没有找到匹配的项目。" en="No matching projects." /></p>
</section>
<dialog class="studio-dialog" id="mediaDialog" aria-labelledby="mediaTitle">
  <div class="studio-dialog-bar"><h2 id="mediaTitle"></h2><button type="button" id="closeMedia" autofocus><T zh="关闭" en="Close" /> ×</button></div>
  <div id="mediaContent"></div>
</dialog>

<script>
  const updatePromos = () => document.dispatchEvent(new Event('promos:visibility'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-app-card]'));
  // Keep keyboard order equal to the phone reading order, restoring desktop copy.
  const phoneLayout = window.matchMedia('(max-width: 600px)');
  const arrangeCardLinks = () => cards.forEach(card => {
    const copy = card.querySelector<HTMLElement>('.studio-copy');
    const links = card.querySelector<HTMLElement>('.studio-card-links');
    if (copy && links) (phoneLayout.matches ? card : copy).append(links);
  });
  arrangeCardLinks();
  phoneLayout.addEventListener('change', arrangeCardLinks);
  const search = document.getElementById('appSearch') as HTMLInputElement | null;
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-platform]:is(button)'));
  let platform = 'all';
  const isEn = () => document.documentElement.dataset.lang === 'en';
  function filterApps() {
    const query = (search?.value || '').trim().toLocaleLowerCase();
    let count = 0;
    cards.forEach(card => {
      const visible = (platform === 'all' || card.dataset.platform === platform) && (card.dataset.search || '').toLocaleLowerCase().includes(query);
      card.hidden = !visible;
      if (visible) count++;
    });
    const counter = document.getElementById('appCount');
    if (counter) counter.textContent = `${count} ${isEn() ? (count === 1 ? 'app' : 'apps') : '款应用'}`;
    const empty = document.getElementById('appEmpty');
    if (empty) empty.hidden = count !== 0;
    updatePromos();
  }
  filters.forEach(button => button.addEventListener('click', () => {
    platform = button.dataset.platform || 'all';
    filters.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    filterApps();
  }));
  search?.addEventListener('input', filterApps);

  const dialog = document.getElementById('mediaDialog') as HTMLDialogElement | null;
  const content = document.getElementById('mediaContent');
  let opener: HTMLElement | null = null;
  document.querySelectorAll<HTMLButtonElement>('[data-expand-image], [data-expand-video], [data-expand-animation]').forEach(button => button.addEventListener('click', () => {
    if (!dialog || !content) return;
    opener = button;
    const title = document.getElementById('mediaTitle');
    if (title) title.textContent = button.dataset.title || '';
    content.replaceChildren();
    if (button.dataset.expandVideo) {
      const video = document.createElement('video');
      video.src = button.dataset.expandVideo;
      video.poster = button.dataset.poster || '';
      video.controls = true;
      video.muted = true;
      video.playsInline = true;
      video.preload = 'none';
      content.append(video);
    } else if (button.dataset.expandAnimation) {
      const wrapper = document.createElement('div');
      const frame = document.createElement('div');
      frame.className = 'studio-animation';
      frame.dataset.promoAnimation = '';
      frame.setAttribute('role', 'img');
      frame.setAttribute('aria-label', button.dataset.title || '');
      const poster = document.createElement('img');
      poster.dataset.promoPoster = ''; poster.src = button.dataset.poster || ''; poster.alt = '';
      const image = document.createElement('img');
      image.dataset.promoAnimated = ''; image.dataset.src = button.dataset.expandAnimation; image.alt = ''; image.hidden = true;
      const canvas = document.createElement('canvas');
      canvas.width = 0; canvas.height = 0; canvas.hidden = true; canvas.setAttribute('aria-hidden', 'true');
      frame.append(poster, image, canvas);
      const actions = document.createElement('div'); actions.className = 'studio-media-actions';
      const toggle = document.createElement('button'); toggle.type = 'button'; toggle.dataset.promoToggle = ''; toggle.textContent = isEn() ? 'Play' : '播放';
      actions.append(toggle); wrapper.append(frame, actions); content.append(wrapper);
      updatePromos();
    } else {
      const image = document.createElement('img');
      image.src = button.dataset.expandImage || '';
      image.alt = button.dataset.title || '';
      content.append(image);
    }
    dialog.showModal();
    document.body.classList.add('media-open');
    updatePromos();
  }));
  document.getElementById('closeMedia')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  dialog?.addEventListener('close', () => {
    content?.querySelector('video')?.pause();
    content?.replaceChildren();
    updatePromos();
    document.body.classList.remove('media-open');
    opener?.focus();
    updatePromos();
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) content?.querySelector('video')?.pause();
  });
</script>

<script>
  const projectCards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-card]'));
  const projectSearch = document.getElementById('projectSearch') as HTMLInputElement | null;
  const projectFilters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-project-category]'));
  let projectCategory = 'active';
  function filterProjects() {
    const query = (projectSearch?.value || '').trim().toLocaleLowerCase();
    let count = 0;
    projectCards.forEach(card => {
      const archived = card.dataset.archived === 'true', fork = card.dataset.fork === 'true';
      const matches = projectCategory === 'all' || (projectCategory === 'archived' ? archived : projectCategory === 'fork' ? fork : !archived && !fork && (projectCategory === 'active' || projectCategory === card.dataset.category));
      const show = matches && (card.dataset.search || '').toLocaleLowerCase().includes(query);
      card.hidden = !show;
      if (show) count++;
    });
    const counter = document.getElementById('projectCount');
    if (counter) counter.textContent = `${count} ${document.documentElement.dataset.lang === 'en' ? (count === 1 ? 'project' : 'projects') : '个项目'}`;
    const empty = document.getElementById('projectEmpty');
    if (empty) empty.hidden = count !== 0;
  }
  projectSearch?.addEventListener('input', filterProjects);
  projectFilters.forEach(button => button.addEventListener('click', () => {
    projectCategory = button.dataset.projectCategory || 'all';
    projectFilters.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    filterProjects();
  }));
</script>
