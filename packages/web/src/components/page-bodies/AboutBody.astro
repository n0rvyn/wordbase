---
// Shared about-page body. Single source of markup + scoped styles + the
// styles for both the zh shell (pages/about.astro) and the en
// shell (pages/en/about.astro). All copy renders through <T> dual-copy, and
// there are no internal locale-prefixed links (contact is mailto/GitHub), so
// the body is locale-identical — no props needed.
import T from '../T.astro';
---

<header class="about-header wrap">
  <div class="about-heading"><div><div class="eyebrow"><T k="about.eyebrow" /></div><h1><T k="about.h1" /></h1></div><div class="portrait" aria-hidden="true">N</div></div>
  <p class="lede"><T k="about.lede" /></p>
</header>

<section class="sec wrap">
  <div class="row2">
    <div class="spine">
      <span class="no">01</span>
      <span class="lab"><T k="about.story.lab" /></span>
      <span class="note"><T k="about.story.note" /></span>
    </div>
    <div class="prose-a">
      <p><T k="about.story.p1" /></p>
      <p><T k="about.story.p2" /></p>
      <p><T k="about.story.p3" /></p>
      <p><T k="about.story.p4" /></p>
      <p><T k="about.story.p5" /></p>
    </div>
  </div>
</section>

<section class="sec wrap">
  <div class="row2">
    <div class="spine">
      <span class="no">02</span>
      <span class="lab"><T k="about.now.lab" /></span>
      <span class="note"><T k="about.now.note" /></span>
    </div>
    <div class="now-list">
      <div class="now-item">
        <span class="nk"><T k="about.now.building" /></span>
        <span class="nv"><T k="about.now.building.v" /></span>
      </div>
      <div class="now-item">
        <span class="nk"><T k="about.now.preparing" /></span>
        <span class="nv"><T k="about.now.preparing.v" /></span>
      </div>
      <div class="now-item">
        <span class="nk"><T k="about.now.writing" /></span>
        <span class="nv"><T k="about.now.writing.v" /></span>
      </div>
    </div>
  </div>
</section>

<section class="sec wrap">
  <div class="row2">
    <div class="spine">
      <span class="no">03</span>
      <span class="lab"><T k="about.contact.lab" /></span>
      <span class="note"><T k="about.contact.note" /></span>
    </div>
    <div>
      <p class="prose-a" style="margin-bottom:24px"><T k="about.contact.lede" /></p>
      <div class="contact-row">
        <a class="cbtn pri" href="mailto:norvyn@norvyn.com">
          <T k="about.contact.email" />
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
        </a>
        <a class="cbtn" href="https://github.com/n0rvyn" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </div>
</section>

<style>
  .sec {
    padding: clamp(44px, 6vw, 84px) 0;
    border-top: 1px solid var(--line);
  }

  /* ── Hero layout ── */
  .about-header { padding-block: 30px 28px; }
  .about-heading { display: flex; align-items: center; justify-content: space-between; gap: 24px; max-width: 760px; }
  .about-header .eyebrow { color: var(--ink-2); font-size: 10px; letter-spacing: .12em; margin-bottom: 8px; }
  .about-header h1 { font: 500 clamp(28px,3vw,38px)/1.2 var(--font-display); letter-spacing: -.03em; margin: 0; }
  .about-header .lede { max-width: 65ch; font-size: 16px; line-height: 1.8; margin-top: 16px; color: var(--ink-2); }
  .about-header .portrait { width: 64px; height: 64px; flex: 0 0 64px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--line); background: var(--surface-2); color: var(--accent); font: italic 36px/1 var(--font-editorial); }
  /* ── Prose ── */
  .prose-a {
    font-family: var(--font-read);
    font-size: 17px;
    line-height: 1.9;
    color: var(--ink-2);
    max-width: 60ch;
  }
  .prose-a p { margin: 0 0 1.3em; }
  .prose-a strong { color: var(--ink); font-weight: 600; }

  /* ── Now list ── */
  .now-list { display: flex; flex-direction: column; }
  .now-item {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 24px;
    padding: 18px 4px;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }
  .now-item:first-child { border-top: none; }
  .now-item .nk {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .now-item .nv {
    font-family: var(--font-read);
    font-size: 15.5px;
    color: var(--ink);
    line-height: 1.6;
  }
  .now-item .nv b { font-weight: 600; }

  /* ── Colophon ── */
  .colophon { display: flex; flex-direction: column; gap: 14px; }
  .colophon .cl {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 24px;
    font-size: 14.5px;
  }
  .colophon .ck {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .colophon .cv { color: var(--ink-2); }

  /* ── Accent swatches ── */
  .sw-row { display: flex; gap: 9px; }
  .sw {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    cursor: pointer;
    border: 2px solid transparent;
    transition: transform .15s;
    position: relative;
  }
  .sw:hover { transform: scale(1.1); }
  .sw.sel { border-color: var(--ink-3); }
  .sw.sel::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(0,0,0,.15);
  }

  /* ── Contact ── */
  .contact-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .cbtn {
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    padding: 12px 20px;
    border-radius: 99px;
    border: 1px solid var(--line-2);
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: transform .18s var(--ease), border-color .2s, background .2s;
  }
  .cbtn:hover { transform: translateY(-1px); border-color: var(--ink-3); background: var(--surface-2); }
  .cbtn.pri { background: var(--accent); color: var(--on-accent); border-color: transparent; }
  .cbtn svg { width: 14px; height: 14px; }

  /* ── Responsive ── */
  @media (max-width: 560px) {
    .now-item,
    .colophon .cl { grid-template-columns: 1fr; gap: 5px; }
  }
</style>
