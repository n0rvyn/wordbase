# Production Caddy config: WordBase serves the apex norvyn.com
# (WordPress decommissioned 2026-05-30). blog.norvyn.com 301-redirects to apex.
# Deployed to /etc/caddy/sites.v2/wordbase by deploy/setup.sh.
norvyn.com {
    tls norvyn@norvyn.com
    encode gzip

    # API requests → Node.js
    handle /api/* {
        reverse_proxy localhost:4100
    }

    # Uploaded media → direct file serving
    handle /uploads/* {
        root * /var/www/wordbase/packages/api/data/uploads
        uri strip_prefix /uploads
        file_server
    }

    # Posts: serve the static page if it exists, otherwise fall back to Node so the
    # redirect middleware can 301 (old CJK slug → new pinyin slug, and /posts/<id>
    # canonicalization). Must precede the catch-all static handle below.
    handle /posts/* {
        root * /var/www/wordbase/packages/web/dist
        @exists file {path} {path}.html
        handle @exists {
            try_files {path} {path}.html
            file_server
        }
        handle {
            reverse_proxy localhost:4100
        }
    }

    # Static site → Astro build output
    #
    # /404.html is deliberately NOT in try_files: listing it there makes it a
    # MATCHED file, so file_server serves the 404 page with status 200 — a soft
    # 404. Search engines then keep indexing withdrawn pages (an unpublished app
    # at /apps/<slug> read as a live page). Letting file_server miss and catching
    # it in handle_errors keeps the same body with the right status.
    handle {
        root * /var/www/wordbase/packages/web/dist
        try_files {path} {path}.html {path}/index.html
        file_server
    }

    # Custom error pages. `status 404` is load-bearing: file_server inside
    # handle_errors serves the rewritten file as a normal 200 hit otherwise,
    # which is the very defect above moved one route down.
    handle_errors {
        @404 expression {err.status_code} == 404
        handle @404 {
            root * /var/www/wordbase/packages/web/dist
            rewrite * /404.html
            file_server {
                status 404
            }
        }
        handle {
            respond "{err.status_code} {err.status_text}"
        }
    }

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# Old blog subdomain → apex (keep existing links working)
blog.norvyn.com {
    tls norvyn@norvyn.com
    redir https://norvyn.com{uri} permanent
}
